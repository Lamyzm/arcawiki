ode": 0, "inputs": [{"name": "pixels", "type": "IMAGE", "link": 11}, {"name": "vae", "type": "VAE", "link": 12}], "outputs": [{"name": "LATENT", "type": "LATENT", "links": [13], "slot_index": 0}], "widgets_values": [], "title": "B-2. 인코딩"}, {"id": 22, "type": "RepeatLatentBatch", "pos": [920, 1230], "size": [300, 60], "flags": {}, "order": 12, "mode": 0, "inputs": [{"name": "samples", "type": "LATENT", "link": 13}], "outputs": [{"name": "LATENT", "type": "LATENT", "links": [17], "slot_index": 0}], "widgets_values": [4], "title": "B-3. 4벌로 복제 — 몇 장 변형할지"}, {"id": 23, "type": "KSampler", "pos": [920, 1330], "size": [330, 290], "flags": {}, "order": 13, "mode": 0, "inputs": [{"name": "model", "type": "MODEL", "link": 14}, {"name": "positive", "type": "CONDITIONING", "link": 15}, {"name": "negative", "type": "CONDITIONING", "link": 16}, {"name": "latent_image", "type": "LATENT", "link": 17}], "outputs": [{"name": "LATENT", "type": "LATENT", "links": [18], "slot_index": 0}], "widgets_values": [0, "randomize", 30, 5.0, "er_sde", "simple", 0.5], "title": "B-4. denoise 가 변형 강도"}, {"id": 24, "type": "VAEDecode", "pos": [1300, 1130], "size": [250, 60], "flags": {}, "order": 14, "mode": 0, "inputs": [{"name": "samples", "type": "LATENT", "link": 18}, {"name": "vae", "type": "VAE", "link": 19}], "outputs": [{"name": "IMAGE", "type": "IMAGE", "links": [20], "slot_index": 0}], "widgets_values": []}, {"id": 25, "type": "SaveImage", "pos": [1300, 1230], "size": [420, 400], "flags": {}, "order": 15, "mode": 0, "inputs": [{"name": "images", "type": "IMAGE", "link": 20}], "outputs": [], "widgets_values": ["grid/B_var"], "title": "B-5. 변형 4장 저장"}, {"id": 90, "type": "MarkdownNote", "pos": [60, 620], "size": [330, 430], "flags": {}, "order": 16, "mode": 0, "inputs": [], "outputs": [], "title": "읽어라 — 미드저니식으로 쓰는 법", "widgets_values": ["## 두 단계로 나뉜다\n\n**A. 그리드** — 미드저니가 4장 주는 그것\n1. `A-1` 의 `batch_size` 가 장 수다. **4** 로 둔다\n2. `A-2` 시드는 **randomize** 로 (매번 다른 4장)\n3. 실행 → `grid/A_grid` 폴더에 4장\n\n**B. 변형** — 미드저니의 `V` 버튼\n1. A 에서 고른 그림을 `B-1` 에 넣는다\n2. `B-3` 이 변형 장 수. **4**\n3. 실행 → `grid/B_var` 에 4장\n\n**변형 강도는 `B-4` 의 denoise**\n\n| 값 | 미드저니로 치면 |\n|---|---|\n| `0.3~0.4` | Subtle |\n| **`0.5`** | **Strong (기본)** |\n| `0.6~0.7` | 거의 새 그림 |\n| `0.8+` | 원본이 안 남는다 |\n\n**미드저니의 `U`(업스케일)는** 이 워크플로우에 없다.\nAiO 워크플로우의 HighRes/Upscale 그룹이 그 자리다.\n고른 PNG 를 AiO 캔버스에 끌어다 놓고 그 그룹만 켜면 된다.\n\n**batch_size 를 너무 올리지 말 것.**\nVRAM 이 장 수만큼 곱해서 든다.\n16GB 에서 832x1216 기준 4장이 안전선이다."]}], "links": [[1, 1, 0, 4, 0, "MODEL"], [2, 2, 0, 5, 0, "CLIP"], [3, 2, 0, 6, 0, "CLIP"], [4, 4, 0, 11, 0, "MODEL"], [5, 5, 0, 11, 1, "CONDITIONING"], [6, 6, 0, 11, 2, "CONDITIONING"], [7, 10, 0, 11, 3, "LATENT"], [8, 11, 0, 12, 0, "LATENT"], [9, 3, 0, 12, 1, "VAE"], [10, 12, 0, 13, 0, "IMAGE"], [11, 20, 0, 21, 0, "IMAGE"], [12, 3, 0, 21, 1, "VAE"], [13, 21, 0, 22, 0, "LATENT"], [14, 4, 0, 23, 0, "MODEL"], [15, 5, 0, 23, 1, "CONDITIONING"], [16, 6, 0, 23, 2, "CONDITIONING"], [17, 22, 0, 23, 3, "LATENT"], [18, 23, 0, 24, 0, "LATENT"], [19, 3, 0, 24, 1, "VAE"], [20, 24, 0, 25, 0, "IMAGE"]], "groups": [{"id": 1, "title": "A. 그리드 — 한 번에 4장", "bounding": [420, 500, 1320, 580], "color": "#3f5159", "font_size": 26, "flags": {}}, {"id": 2, "title": "B. 변형 — 고른 것에서 4장", "bounding": [420, 1070, 1320, 580], "color": "#59433f", "font_size": 26, "flags": {}}], "config": {}, "version": 0.4}